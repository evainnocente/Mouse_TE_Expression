    --attribute transcript_id
    echo "$(date): $SAMPLENAME count completed" >> "$LOGFILE"
done

# Deactivate the environment (optional)
deactivate

# Rename output files with sample names:
find . -type f -print0 |
while IFS= read -r -d '' file; do
    dir=$(dirname "$file")
    base=$(basename "$file")
    ext="${base##*.}"

    if [ "$base" = "$ext" ]; then
        newname="${dir}/${dir##*/}"
    else
        newname="${dir}/${dir##*/}.${ext}"
    fi

    [ "$file" = "$newname" ] && continue

    count=1
    while [ -e "$newname" ]; do
        if [ "$base" = "$ext" ]; then
            newname="${dir}/${dir##*/}_$count"
        else
            newname="${dir}/${dir##*/}_$count.${ext}"
        fi
        count=$((count+1))
    done
    mv -n "$file" "$newname";
done

