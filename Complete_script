## downloading the reference genome files and rpeeatmasker track, editing it, etc.

# Download mouse genome (mm10) repeat masker track from UCSC genome browser:
wget https://hgdownload.soe.ucsc.edu/goldenPath/mm39/database/rmsk.txt.gz

# Download mouse reference genome (Ensembl 115) and annotations that contain scaffolds etc. as per STAR manual.
wget https://ftp.ensembl.org/pub/release-115/fasta/mus_musculus/dna/Mus_musculus.GRCm39.dna.primary_assembly.fa.gz
wget https://ftp.ensembl.org/pub/release-115/gtf/mus_musculus/Mus_musculus.GRCm39.115.gtf.gz

# Extracting gene names to check if everything matches between the fasta file and the annotation files first
grep "^>" Mus_musculus.GRCm39.dna.primary_assembly.fa | sed '/^>/ s/ .*//' > fasta_IDs.txt
sed -i 's/>//g' fasta_IDs.txt
cut -f6 rmsk.txt | sort -u > ucsc_ids.txt
sed -i 's/^.\{3\}//' ucsc_ids.txt
sed -i 's/_random//g' ucsc_ids.txt
sed -i s/v/./g ucsc_ids.txt
sed -i 's/^[^_]*_//' ucsc_ids.txt
sed -i 's/\bM\b/MT/g' ucsc_ids.txt
grep -v "^#" Mus_musculus.GRCm39.115.gtf | cut -f1 | sort -u > gtf_IDS.txt
cat gtf_IDS.txt ucsc_ids.txt > all_gtf_ids.txt
echo "Matches:"
grep -xFf all_gtf_ids.txt fasta_IDs.txt
echo "Non-matches:"
grep -vxFf all_gtf_ids.txt fasta_IDs.txt # No non-matches

# Edit fields to conform with ensembl naming conventions to match fasta file and convert text to .gtf

awk 'BEGIN{FS=OFS="\t"}{sub(/^chr/, "", $6) sub(/_random$/, "", $6) sub(/^.*_/, "", $6) gsub(/v/, ".", $6) if ($6=="M") $6="MT"print}' rmsk.txt > rmsk_edited.txt

awk -F'\t' -v OFS='\t' 'NR>1 {print $6, "RepeatMasker", "exon", $7+1, $8, ".", $10, ".", "gene_id \"" $11 "_" $6 "_" $7 "\"; transcript_id \"" $11 "_" $6 "_" $7 "\"; repeat_class \"" $12 "\"; repeat_family \"" $13 "\";"}' rmsk_edited.txt > TE_repeatmasker_track.gtf

# Combine the RepeatMasker annotation and reference genome
cat Mus_musculus.GRCm39.115.gtf TE_repeatmasker_track.gtf > combined_refgenome_TEs.gtf

