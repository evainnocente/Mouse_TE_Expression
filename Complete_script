ml bedtools/2.31.0
# wo option preserves all fields and coordinates, -F 1.0 is 100% overlap
bedtools intersect -wo -F 1.0 -a lncRNA_transcripts_only.gtf -b female_signif_TEs.gtf > female_TEderived_lncRNAs.gtf
# Check line numbers
wc -l female_TEderived_lncRNAs.gtf
448 female_TEderived_lncRNAs.gtf
# Intersect
bedtools intersect -wo -F 1.0 -a lncRNA_transcripts_only.gtf -b male_signif_TEs.gtf > male_TEderived_lncRNAs.gtf
wc -l male_TEderived_lncRNAs.gtf
2 male_TEderived_lncRNAs.gtf
